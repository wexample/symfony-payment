{
  "name": "wexample/symfony-payment",
  "description": "Payments for Symfony: a guarded status machine, provider-agnostic collection, webhooks and events",
  "type": "library",
  "license": "MIT",
  "version": "2.0.2",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyPayment\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyPayment\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=15.0.0",
    "wexample/symfony-money": ">=5.0.0",
    "wexample/symfony-remote-payment": ">=2.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}